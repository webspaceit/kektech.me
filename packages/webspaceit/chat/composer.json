{
    "name": "webspaceit/laravel-live-chat",
    "description": "Live chat module for Laravel + Inertia.js + React projects",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "WebspaceIt\\Chat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebspaceIt\\Chat\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebspaceIt\\Chat\\ChatServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    }
}
