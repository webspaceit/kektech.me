{
    "name": "app/live-chat",
    "description": "Real-time live chat package for Laravel with React frontend, polling-based messaging, typing indicators, and online status.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\LiveChat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\LiveChat\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "App\\LiveChat\\LiveChatServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
